<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>RouteServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.transport.server.RouteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RouteServlet</servlet-name>
        <url-pattern>/routes</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VehicleServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.transport.server.VehicleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VehicleServlet</servlet-name>
        <url-pattern>/vehicles</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IncidentServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.transport.server.IncidentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IncidentServlet</servlet-name>
        <url-pattern>/incidents</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResponseTaskServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.transport.server.ResponseTaskServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResponseTaskServlet</servlet-name>
        <url-pattern>/tasks</url-pattern>
    </servlet-mapping>
</web-app>
